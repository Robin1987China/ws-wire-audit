{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ws-wire-audit/declaration.schema.json",
  "title": "ws-wire-audit measurement declaration",
  "description": "A machine-readable 'measurement declaration': the four calibers of SPEC.md (business-message definition; payload vs wire bytes; compression state; egress and window), plus observation metadata, business metrics, a capture checksum, and a reproduction command. Status: PROPOSED, not a standard. See spec/README.md.",
  "type": "object",
  "required": [
    "declaration_version",
    "status",
    "observation",
    "business_message",
    "bytes",
    "compression",
    "metrics",
    "checksum",
    "reproduce"
  ],
  "additionalProperties": false,
  "properties": {
    "declaration_version": {
      "description": "Schema/format generation this document conforms to.",
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "description": "Fixed marker that this is an unadopted proposal, per SPEC.md.",
      "type": "string",
      "const": "proposed"
    },
    "observation": {
      "description": "Who/where/when: venue, symbol counts, window and egress.",
      "type": "object",
      "required": [
        "venue",
        "symbols_requested",
        "symbols_succeeded",
        "start",
        "end",
        "duration_s",
        "exit_code",
        "tool",
        "tool_version"
      ],
      "additionalProperties": false,
      "properties": {
        "venue": {"type": "string", "minLength": 1},
        "symbols_requested": {"type": "integer", "minimum": 0},
        "symbols_succeeded": {"type": "integer", "minimum": 0},
        "start": {
          "description": "Calendar start of the observation window (ISO date or date-time).",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$"
        },
        "end": {
          "description": "Calendar end of the observation window (ISO date or date-time).",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$"
        },
        "duration_s": {
          "description": "Window length in seconds, measured from after subscribe (SPEC 1.4).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exit_code": {
          "description": "Process exit code of the session; 0 means the capture ran to completion.",
          "type": "integer"
        },
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "egress": {
          "description": "Public network origin (region/ASN), or the literal string 'unknown'. Declare it; do not omit it.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "business_message": {
      "description": "SPEC 1.1: what counts as one business message, and what is excluded.",
      "type": "object",
      "required": [
        "definition",
        "direction",
        "excludes_control_frames",
        "excludes_heartbeats",
        "excludes_acks",
        "reassembles_fragments"
      ],
      "additionalProperties": false,
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "const": "inbound"},
        "excludes_control_frames": {"type": "boolean"},
        "excludes_heartbeats": {"type": "boolean"},
        "excludes_acks": {"type": "boolean"},
        "reassembles_fragments": {"type": "boolean"}
      }
    },
    "bytes": {
      "description": "SPEC 1.2: how byte counts are defined.",
      "type": "object",
      "required": [
        "wire_includes_frame_header",
        "payload_is_post_inflate",
        "direction",
        "includes_tls_tcp_ip",
        "client_uplink_measured"
      ],
      "additionalProperties": false,
      "properties": {
        "wire_includes_frame_header": {"type": "boolean"},
        "payload_is_post_inflate": {"type": "boolean"},
        "direction": {"type": "string", "const": "server_to_client"},
        "includes_tls_tcp_ip": {"type": "boolean"},
        "client_uplink_measured": {"type": "boolean"}
      }
    },
    "compression": {
      "description": "SPEC 1.3: the four-state compression-negotiation declaration, plus both header strings and the probe ladder.",
      "type": "object",
      "required": [
        "state",
        "offered_header",
        "response_header",
        "probe",
        "probe_method",
        "measurement_offer_source"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "description": "not_offered = we never asked; server_refused = we asked, server declined; accepted = active; unsolicited = server sent it unasked.",
          "type": "string",
          "enum": ["not_offered", "server_refused", "accepted", "unsolicited"]
        },
        "offered_header": {
          "description": "The Sec-WebSocket-Extensions string we sent, or null if we sent no offer.",
          "type": ["string", "null"]
        },
        "response_header": {
          "description": "The Sec-WebSocket-Extensions string the server returned, or null if absent.",
          "type": ["string", "null"]
        },
        "probe": {
          "description": "The ladder: each offer variant sent and the server's verdict for it. Empty when no ladder was run.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["offer", "status"],
            "additionalProperties": false,
            "properties": {
              "offer": {"type": "string", "minLength": 1},
              "status": {
                "type": "string",
                "enum": ["not_offered", "server_refused", "accepted", "unsolicited"]
              }
            }
          }
        },
        "probe_method": {
          "description": "none = no offer made; single-offer = exactly one offer, no ladder; ladder = multi-variant probe recorded in probe[].",
          "type": "string",
          "enum": ["none", "single-offer", "ladder"]
        },
        "measurement_offer_source": {
          "description": "Which offer the measured session itself carried (SPEC 1.3).",
          "type": "string",
          "enum": ["none", "single-offer", "ladder-accepted", "ladder-fallback-first-offer"]
        }
      }
    },
    "metrics": {
      "description": "The measured figures for this session.",
      "type": "object",
      "required": [
        "business_messages",
        "msg_per_s",
        "wire_bytes",
        "wire_bytes_per_s",
        "payload_bytes",
        "payload_bytes_per_s",
        "size_bytes",
        "acks",
        "control_frames",
        "heartbeat_frames"
      ],
      "additionalProperties": false,
      "properties": {
        "business_messages": {"type": "integer", "minimum": 0},
        "msg_per_s": {"type": "number", "minimum": 0},
        "wire_bytes": {"type": "integer", "minimum": 0},
        "wire_bytes_per_s": {"type": "number", "minimum": 0},
        "payload_bytes": {"type": "integer", "minimum": 0},
        "payload_bytes_per_s": {"type": "number", "minimum": 0},
        "wire_bytes_total": {"type": "integer", "minimum": 0},
        "size_bytes": {
          "description": "Per-message payload-size distribution, in bytes.",
          "type": "object",
          "required": ["min", "p50", "p90", "p99", "max", "mean"],
          "additionalProperties": false,
          "properties": {
            "min": {"type": "number", "minimum": 0},
            "p50": {"type": "number", "minimum": 0},
            "p90": {"type": "number", "minimum": 0},
            "p99": {"type": "number", "minimum": 0},
            "max": {"type": "number", "minimum": 0},
            "mean": {"type": "number", "minimum": 0}
          }
        },
        "acks": {"type": "integer", "minimum": 0},
        "control_frames": {"type": "integer", "minimum": 0},
        "heartbeat_frames": {"type": "integer", "minimum": 0}
      }
    },
    "checksum": {
      "description": "Integrity link back to the raw capture the numbers were derived from.",
      "type": "object",
      "required": ["capture_sha256", "algorithm"],
      "additionalProperties": false,
      "properties": {
        "capture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "algorithm": {"type": "string", "const": "sha256"}
      }
    },
    "reproduce": {
      "description": "The exact command(s) that produced the capture.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
